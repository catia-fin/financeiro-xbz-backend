# Copie este arquivo para ".env" e preencha com valores reais antes de subir para produção.

# String de conexão do banco Postgres (o provedor de hospedagem fornece isso)
DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/nome_banco

# Chave secreta para assinar os logins (gere uma aleatória e forte, não reaproveite)
JWT_SECRET=troque-esta-chave-antes-de-ir-para-producao

# Por quanto tempo (minutos) um login fica válido sem precisar entrar de novo
JWT_EXPIRE_MINUTES=480

# Chave usada só pelo watcher local para autenticar o envio de dados (gere outra chave forte)
WATCHER_API_KEY=defina-uma-chave-forte-aqui

# Código que você passa pras 3 pessoas que vão usar o sistema — sem ele,
# ninguém consegue criar conta nem redefinir senha pela tela de cadastro.
CODIGO_CONVITE=defina-um-codigo-aqui

# Domínio(s) do site que terão permissão de chamar esta API, separados por vírgula
CORS_ORIGINS=https://financeiro.suaempresa.com.br
